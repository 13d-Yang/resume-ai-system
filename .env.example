# ============================================================
# 环境变量模板：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）
# Windows 下也可直接设置【用户环境变量】，服务启动时会自动读取
# ============================================================

# 智谱大模型（聊天/分析）：https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here

# 硅基流动（bge-large-zh 向量化）：https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# MySQL 密码（默认 root，生产环境务必修改）
MYSQL_PASSWORD=root

# 可选：简历文件白名单根目录（默认为项目根的上一级目录）
# RESUME_BASE_DIR=C:\Users\简历测试数据
